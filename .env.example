# Environment configuration
# Database
DATABASE_URL=postgresql://user:password@localhost:5432/market_intelligence
REDIS_URL=redis://localhost:6379

# API Keys
OPENAI_API_KEY=sk-...
MEXC_API_KEY=...
MEXC_API_SECRET=...
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...
NEWS_API_KEY=...
SEC_USER_AGENT=Market-Intelligence-Bot/1.0

# X API (Sprint 7)
# X_API_KEY=...
# X_API_SECRET=...

# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# SLA Targets (milliseconds, configurable per source tier)
SLA_P50_BREAKING=3000
SLA_P95_BREAKING=180000
SLA_P50_NEWS=5000
SLA_P95_NEWS=600000

# AI Cost Controls
AI_DAILY_SPEND_CAP_USD=100
